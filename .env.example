# ============================================================
# E-Commerce Operations Optimization - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Flask ────────────────────────────────────────────────────
FLASK_ENV=development               # development | production
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here     # openssl rand -hex 32

# ── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_ops
DB_USER=postgres
DB_PASSWORD=your_password_here
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── SQLite (alternative for local dev — no Postgres needed) ──
# DATABASE_URL=sqlite:///ecommerce_ops.db

# ── Redis (Celery task queue) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-here # openssl rand -hex 32
JWT_ACCESS_TOKEN_EXPIRES=3600       # seconds (1 hour)

# ── ML Model ─────────────────────────────────────────────────
MODEL_PATH=models/random_forest_model.pkl
MODEL_VERSION=1.0.0
HIGH_RISK_THRESHOLD=0.60            # Probability above which order = high-risk

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/app.log

# ── Business Config ──────────────────────────────────────────
DELAY_COST_PER_ORDER=100            # ₹ cost per delayed order
RETURN_COST_PER_ORDER=500           # ₹ cost per returned order
